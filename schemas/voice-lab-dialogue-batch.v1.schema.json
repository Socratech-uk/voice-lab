{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Voice Lab dialogue batch v1",
  "type": "object",
  "required": ["protocol", "items"],
  "properties": {
    "protocol": {"const": "capp.voice-lab.dialogue-batch.v1"},
    "items": {
      "type": "array", "minItems": 1, "maxItems": 1000,
      "items": {
        "type": "object", "required": ["characterId", "text"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 128},
          "revision": {"type": "integer", "minimum": 0},
          "characterId": {"type": "string", "minLength": 1, "maxLength": 128},
          "title": {"type": "string", "maxLength": 160},
          "text": {"type": "string", "minLength": 1},
          "type": {"type": "string", "maxLength": 80},
          "typeId": {"type": ["string", "null"], "maxLength": 128},
          "notes": {"type": "string", "maxLength": 12000},
          "tags": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 64}},
          "status": {"enum": ["draft", "ready"]},
          "settings": {"type": "object", "description": "Character delivery settings returned by characters.get; omitted or invalid controls use the normal Voice Lab defaults."},
          "origin": {"type": "object", "required": ["kind"], "properties": {"kind": {"enum": ["manual", "automation", "import"]}, "jobId": {"type": "string", "maxLength": 128}}}
        }
      }
    }
  }
}
